# ─── Ethereum RPC ────────────────────────────────────────────────────────────
# Accepts a comma-separated list, tried in order until one responds. The first
# working endpoint is remembered for 5 minutes and re-probed as soon as a call
# fails, so a node whose address moves (a DAppNode on DHCP, say) falls back
# instead of taking the dashboard down.
#
# IMPORTANT: Distribution History needs wide `eth_getLogs` scans — roughly 120
# sequential 50k-block queries plus 8 parallel bond-event scans. Public
# endpoints rate-limit or time out on that, which surfaces as an RPC error on
# the History panel. Use your own node for it; a public entry is a reasonable
# last resort for the lighter pages.
#
#   ETH_RPC_URL="http://192.168.1.50:8545,https://ethereum-rpc.publicnode.com"
#
# Tip: give a self-hosted node a DHCP reservation on your router. That fixes a
# moving IP at the source — failover is the safety net, not the cure.
ETH_RPC_URL="https://ethereum-rpc.publicnode.com"

# ─── Web server ──────────────────────────────────────────────────────────────
# Precedence: `csm serve --port` flag > PORT env var > this file > default.
# The Docker image sets HOST=0.0.0.0 and PORT=3000 as its own defaults.
# HOST=127.0.0.1
# PORT=8080

# ─── Cache / data directory ──────────────────────────────────────────────────
# Root for the saved-operator database, the discovered distribution-CID cache
# and the IPFS log cache. In a container this must point at a mounted volume,
# or distribution history re-runs full discovery on every restart.
# CACHE_DIR=~/.cache/csm-dashboard
# DATABASE_PATH overrides just the database, independently of CACHE_DIR.

# ─── Beacon chain ────────────────────────────────────────────────────────────
BEACON_API_URL="https://beaconcha.in/api/v1"

# beaconcha.in API key (optional, for higher rate limits)
# Get your API key at https://beaconcha.in/pricing
# BEACON_API_KEY=your_api_key_here

# ─── Etherscan ───────────────────────────────────────────────────────────────
# Optional. Speeds up distribution-CID discovery and withdrawal history; the
# RPC fallback covers both when absent.
# Get your API key at https://etherscan.io/apis
# ETHERSCAN_API_KEY=your_api_key_here

# ─── Cache TTL ───────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300
